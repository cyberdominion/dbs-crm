# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbs_crm"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-secure-random-string"

# Email (optional, for credential recovery)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@example.com"

# App config
APP_URL="http://localhost:3000"
TIMEZONE="Africa/Lagos"
REPORTING_DEADLINE_HOUR="17"

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Backup (managed externally)
BACKUP_ENABLED="true"