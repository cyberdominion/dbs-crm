// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Africa/Lagos")
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  prospects   Prospect[]
  activities  Activity[]
  tasks       Task[]
  reports     DailyReport[]
  auditLogs   AuditLog[]
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String   @default("ASSISTANT") // CEO | ASSISTANT
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  prospects     Prospect[]         @relation("ProspectOwner")
  createdProspects Prospect[]      @relation("ProspectCreator")
  activities    Activity[]
  tasks         Task[]             @relation("TaskAssignee")
  createdTasks  Task[]             @relation("TaskCreator")
  submittedReports DailyReport[] @relation("ReportSubmitter")
  reviewedReports  DailyReport[] @relation("ReportReviewer")
  auditLogs        AuditLog[]

  @@index([organizationId])
  @@index([email])
}

// NextAuth v4 adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prospect {
  id                 String      @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName       String
  normalizedName     String
  category           String?
  location           String?
  website            String?
  socialLinks        String?     // JSON stored as text
  contactPerson      String?
  contactRole        String?
  email              String?
  phone              String?
  whatsappNumber     String?
  digitalPresence    String?
  identifiedNeeds    String?     // JSON stored as text
  proposedServices   String?     // JSON stored as text
  source             String?
  priority           String      @default("MEDIUM") // LOW | MEDIUM | HIGH
  stage              String      @default("NEW") // NEW | RESearched ... etc
  estimatedValue     Decimal?    @db.Decimal(12, 2)
  wonValue           Decimal?    @db.Decimal(12, 2)
  currency           String      @default("NGN")
  lostReason         String?
  nextAction         String?
  nextFollowUpDate   DateTime?
  lastContactAt      DateTime?
  archivedAt         DateTime?
  ownerId            String?
  owner              User?       @relation("ProspectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creatorId          String
  creator            User        @relation("ProspectCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  activities  Activity[]
  tasks       Task[]

  @@index([organizationId])
  @@index([stage])
  @@index([ownerId])
  @@index([nextFollowUpDate])
  @@index([normalizedName])
}

model Activity {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId    String
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // CALL | WHATSAPP | EMAIL | MEETING | NOTE | OTHER
  eventAt       DateTime
  summary       String
  messageContent String? @db.Text
  outcome       String?
  nextAction    String?
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([prospectId])
  @@index([userId])
  @@index([createdAt])
}

model Task {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId    String?
  prospect      Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  status        String   @default("TODO") // TODO | IN_PROGRESS | COMPLETED | CANCELLED
  priority      String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueAt         DateTime?
  completedAt   DateTime?
  assigneeId    String
  assignee      User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       User     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
}

model DailyReport {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("ReportSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  businessDate   DateTime
  prospectsIdentified Int    @default(0)
  initialContacts  Int      @default(0)
  responsesReceived Int     @default(0)
  meetingsBooked   Int      @default(0)
  pipelineChanges  String?
  summary          String?
  blockers         String?
  nextPriorities   String?
  status           String   @default("SUBMITTED") // SUBMITTED | REVIEWED | REJECTED
  submittedAt    DateTime @default(now())
  reviewedAt     DateTime?
  reviewerId     String?
  reviewer       User?    @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([businessDate])
  @@unique([organizationId, userId, businessDate])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String?
  entityId       String?
  metadata       String?  @db.Text // safe JSON, no secrets
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
